<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same user-secrets as the Movie API, so ConnectionStrings:Database is configured once. -->
    <UserSecretsId>favo-series-local-2026</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only for the one-time viewer-import from the old App_Data/movie.db. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <ProjectReference Include="../../src/backend/Favo.Series.Api/Favo.Series.Api.csproj" />
  </ItemGroup>
</Project>
