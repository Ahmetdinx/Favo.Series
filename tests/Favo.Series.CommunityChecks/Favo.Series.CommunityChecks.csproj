<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <ProjectReference Include="../../src/backend/Favo.Series.Api/Favo.Series.Api.csproj" Aliases="movie,global" />
    <ProjectReference Include="$(FavoRoot)/src/backend/Favo.Identity.Api/Favo.Identity.Api.csproj" Aliases="identity" />
  </ItemGroup>
  <Target Name="RequireFavoRoot" BeforeTargets="PrepareForBuild" Condition="'$(FavoRoot)' == ''"><Error Text="Pass -p:FavoRoot=path-to-Favo (the repository with Favo.Identity.Api)" /></Target>
</Project>
